# "production" makes the API refuse to boot with default/missing secrets.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://restaurant:restaurant@postgres:5432/restaurant
REDIS_URL=redis://redis:6379/0
DASHBOARD_JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_GRACE_MINUTES=10
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me
WHATSAPP_API_VERSION=v20.0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CORS_ORIGINS=http://localhost:3000
OWNER_ACCOUNTS_FILE=/data/owner_accounts.json

# --- Messaging channel -------------------------------------------------------
# evolution = Evolution API (works today, no Meta account needed)
# meta      = WhatsApp Business Cloud API (switch to this once a client is live)
ACTIVE_CHANNEL=evolution

# Evolution: one instance per restaurant; the instance name must equal that
# restaurant's phone_number_id in the database.
EVOLUTION_BASE_URL=http://evolution:8080
EVOLUTION_API_KEY=
# Shared secret Evolution sends to /webhooks/evolution (any long random string).
EVOLUTION_WEBHOOK_SECRET=
